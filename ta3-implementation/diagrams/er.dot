digraph chen {
  layout=neato;
  bgcolor=white;
  pad=0.3;
  splines=true;
  node [fontname="Times-Roman", fontsize=14, color=black, fontcolor=black, penwidth=1.2];
  edge [dir=none, color=black, fontname="Times-Roman", fontsize=13, penwidth=1.1];

  node [shape=box, peripheries=1, fixedsize=true, width=1.35, height=0.46];
  AGENT   [label="AGENT",   pos="80,560!"];
  SESSION [label="SESSION", pos="280,560!"];
  EPISODE [label="EPISODE", pos="500,560!"];
  SUMMARY [label="SUMMARY", pos="280,360!"];
  ENTITY  [label="ENTITY",  pos="80,180!"];
  FACT    [label="FACT",    pos="330,180!"];

  node [shape=box, peripheries=2, fixedsize=true, width=1.55, height=0.5];
  EMBEDDING [label="EMBEDDING", pos="560,180!"];

  node [shape=diamond, peripheries=1, fixedsize=true, width=1.2, height=0.7, fontsize=12];
  opens    [label="opens",     pos="180,560!"];
  holds    [label="holds",     pos="390,560!"];
  yields   [label="yields",    pos="280,460!"];
  asserts  [label="asserts",   pos="205,180!"];
  refers   [label="refers to", pos="205,70!"];
  supports [label="supports",  pos="500,370!"];
  succeeds [label="succeeds",  pos="330,70!"];

  node [shape=diamond, peripheries=2, fixedsize=true, width=1.2, height=0.7, fontsize=12];
  embeds [label="embeds", pos="500,180!"];

  node [shape=ellipse, peripheries=1, fixedsize=true, width=1.15, height=0.4, fontsize=13];
  agent_id   [label=<<U>agent_id</U>>,     pos="30,650!"];
  agent_name [label="name",                pos="130,650!"];
  session_id [label=<<U>session_id</U>>,   pos="240,650!"];
  title      [label="title",               pos="350,650!"];
  episode_id [label=<<U>episode_id</U>>,   pos="460,650!"];
  content    [label="content",             pos="590,680!"];
  role       [label="role",                pos="700,540!"];
  forgotten  [label="forgotten",           pos="700,460!"];
  summary_id [label=<<U>summary_id</U>>,   pos="160,360!"];
  body       [label="body",                pos="400,360!"];
  entity_id  [label=<<U>entity_id</U>>,    pos="20,330!"];
  ename      [label="name",                pos="20,90!"];
  kind       [label="kind",                pos="130,330!"];
  fact_id    [label=<<U>fact_id</U>>,      pos="300,330!"];
  predicate  [label="predicate",           pos="500,270!"];
  status     [label="status",              pos="200,10!"];
  valid_from [label="valid_from",          pos="460,10!"];
  emb_id     [label=<<U>embedding_id</U>>, pos="670,250!", width=1.4];
  vector     [label="vector",              pos="670,120!"];

  node [shape=ellipse, peripheries=2, fixedsize=true, width=1.05, height=0.42, fontsize=13];
  alias   [label="alias",   pos="175,255!"];
  kw_ep   [label="keyword", pos="700,620!"];
  kw_fact [label="keyword", pos="400,360!"];

  AGENT -> agent_id;
  AGENT -> agent_name;
  SESSION -> session_id;
  SESSION -> title;
  EPISODE -> episode_id;
  EPISODE -> content;
  EPISODE -> role;
  EPISODE -> forgotten;
  EPISODE -> kw_ep;
  SUMMARY -> summary_id;
  SUMMARY -> body;
  ENTITY -> entity_id;
  ENTITY -> ename;
  ENTITY -> kind;
  ENTITY -> alias;
  FACT -> fact_id;
  FACT -> predicate;
  FACT -> status;
  FACT -> valid_from;
  FACT -> kw_fact;
  EMBEDDING -> emb_id;
  EMBEDDING -> vector;

  AGENT -> opens [label="1"];
  opens -> SESSION [label="N"];
  SESSION -> holds [label="1"];
  holds -> EPISODE [label="N"];
  SESSION -> yields [label="1"];
  yields -> SUMMARY [label="N"];
  ENTITY -> asserts [label="1"];
  asserts -> FACT [label="N"];
  ENTITY -> refers [label="1"];
  refers -> FACT [label="N"];
  EPISODE -> supports [label="1"];
  supports -> FACT [label="N"];
  FACT -> succeeds [label="1"];
  succeeds -> FACT [label="N", constraint=false];
  EPISODE -> embeds [label="1"];
  FACT -> embeds [label="1"];
  SUMMARY -> embeds [label="1"];
  embeds -> EMBEDDING [label="N"];
}
