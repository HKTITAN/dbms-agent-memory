# Scratch space for the measurement harness: database files, WAL segments and
# Postgres data directories, all recreated by `npm run capture`.
.work/

# Editor state, not project state.
.cursor/

# Derived artifacts. The vault generator is seeded, so `npm run vault`
# reproduces `data/vault.json` byte for byte, and at this scale it is 30 MB —
# not worth versioning.
#
# `data/capture.json` is NOT ignored. It is what every figure, every table, every
# sentence with a number in it, and every slide reads from, so it is the one
# derived artifact that belongs in the repository.
data/vault.json
